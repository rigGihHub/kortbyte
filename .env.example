# Neon database connection string: Neon Console -> Connect -> Connection string
DATABASE_URL=

# Neon Auth: Auth -> Configuration / Quickstart
NEON_AUTH_BASE_URL=

# Generate a long local secret (32+ chars). Do not commit it.
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage
NEON_STORAGE_ENDPOINT=https://YOUR_BRANCH.storage.YOUR_REGION.aws.neon.tech
NEON_STORAGE_REGION=eu-central-1
NEON_STORAGE_BUCKET=card-images
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Neon AI Gateway
NEON_AI_GATEWAY_BASE_URL=https://YOUR_BRANCH-api.ai.YOUR_REGION.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=
NEON_AI_CARD_MODEL=gpt-5-mini
